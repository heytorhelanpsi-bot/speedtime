    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "robots-parser": "3.0.1",
    "tsx": "4.19.2",
    "web-push": "3.6.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
