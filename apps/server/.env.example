# --- Infra --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speedtime
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
PORT=4000
LOG_LEVEL=info
# Origem(ns) do frontend permitidas no CORS (separe por vírgula)
WEB_ORIGIN=http://localhost:5173
# URL pública do app (links nos e-mails/Telegram/push)
APP_URL=http://localhost:5173

# --- Coleta -------------------------------------------------------------
FETCH_MIN_HOST_INTERVAL_MS=5000   # intervalo mínimo entre requisições ao mesmo host
FETCH_CACHE_TTL_S=300             # reaproveita a mesma página por N segundos
FETCH_TIMEOUT_MS=15000
FETCH_RESPECT_ROBOTS=true
WORKER_CONCURRENCY=5
ALERT_REARM_HYSTERESIS=0.005      # 0,5%: o preço precisa passar disso acima do alvo para rearmar

# --- Web Push (gere com: npm run vapid -w apps/server) -------------------
# Opcional: sem estas chaves, o app gera um par e guarda no banco
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# --- E-mail (Resend) ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=SpeedTime <alertas@seudominio.com>

# --- Telegram (opcional) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Lojas --------------------------------------------------------------
# Mercado Livre: token OAuth (opcional; sem ele, usa os dados estruturados da página)
ML_ACCESS_TOKEN=
# Amazon Product Advertising API 5 (programa de Associados)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com.br
AMAZON_PAAPI_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com.br
# Shopee API de Afiliados
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# AliExpress Open Platform (afiliados)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Deploy em um único serviço ------------------------------------------
RUN_WORKER=false        # true = a API também roda o worker (usado no render.yaml)
AUTO_MIGRATE=true       # aplica as migrações do banco ao iniciar
# PUBLIC_URL=https://seu-app.exemplo.com   # no Render é detectado sozinho (RENDER_EXTERNAL_URL)
