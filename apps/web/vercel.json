{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://SUA-API.up.railway.app/api/:path*" },
    { "source": "/((?!api/|assets/|sw.js|icon.svg|manifest.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
